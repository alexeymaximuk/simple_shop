@model Shop.Frontend.Models.ResendConfirmationViewModel
@{ ViewData["Title"] = "Resend Confirmation"; }

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <h2>Resend Confirmation Email</h2>
        <form asp-controller="Email" asp-action="ResendConfirmation" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="form-group mb-3">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" class="form-control" type="email" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Resend</button>
        </form>
        <p class="mt-3 text-center">
            <a asp-controller="Login" asp-action="Login">Back to Login</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}