@model List<Shop.Frontend.Models.ProductViewModel>
@{ ViewData["Title"] = "All Products"; }

<div class="container mt-4">
    <h2>All Products</h2>

    <form method="get" asp-action="Index" class="row g-2 mb-4 align-items-center">
        <div class="col-md-4">
            <input name="Name" value="@ViewBag.Filter?.Name" class="form-control" placeholder="Search by name" />
        </div>
        <div class="col-md-2">
            <input name="MinPrice" value="@ViewBag.Filter?.MinPrice" class="form-control" placeholder="Min price" type="number" step="0.01" />
        </div>
        <div class="col-md-2">
            <input name="MaxPrice" value="@ViewBag.Filter?.MaxPrice" class="form-control" placeholder="Max price" type="number" step="0.01" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <p class="text-muted">No products found.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var p in Model)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@p.Name</h5>
                            <p class="card-text text-muted">@p.Description</p>
                            <p class="fw-bold">@p.Price.ToString("0.00")₷</p>
                        </div>
                        <div class="card-footer text-muted small">
                            Added @p.CreateTime.ToString("yyyy-MM-dd")
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>